{
  "name": "@open-pencil/html-engine",
  "version": "0.17.0-beta.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-pencil/open-pencil.git",
    "directory": "packages/html-engine"
  },
  "files": [
    "dist",
    "src",
    "wasm",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./wasm/*": "./wasm/*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run build:wasm && bunx tsdown --config tsdown.config.ts",
    "build:wasm": "bun scripts/wasm.ts",
    "check": "bun run typecheck && bun run build",
    "check:licenses": "cargo deny --manifest-path crate/Cargo.toml check licenses",
    "check:rust": "cargo fmt --manifest-path crate/Cargo.toml --check && cargo clippy --manifest-path crate/Cargo.toml --target wasm32-unknown-unknown --release -- -D warnings && cargo clippy --manifest-path crate/Cargo.toml --release -- -D warnings",
    "prepack": "bun run build",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@open-pencil/scene-graph": "workspace:*"
  },
  "dependencies": {
    "@open-pencil/dom-css": "workspace:*",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@open-pencil/test-support": "workspace:*",
    "@types/bun": "^1.3.14",
    "tsdown": "^0.22.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
