# The Node runtime reads durable settings from this TOML file.
OPENPENCIL_CLOUD_CONFIG=./openpencil-cloud.toml
# The site build (`bun run build:cloud`): the editor, sign-in, account, and administration pages.
OPENPENCIL_CLOUD_SITE_DIR=./dist-cloud
PORT=8787

# Required secrets. The conventional names below are the TOML defaults.
DATABASE_URL=postgresql://openpencil:openpencil-development-password@localhost:54329/openpencil
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
S3_ACCESS_KEY_ID=openpencil
S3_SECRET_ACCESS_KEY=openpencil-development-secret

# Optional secrets are required only when their corresponding TOML section is enabled.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_PRIVATE_KEY=
# S3_SESSION_TOKEN=
# OPENPENCIL_CLOUD_SMTP_USER=
# OPENPENCIL_CLOUD_SMTP_PASSWORD=
# OPENPENCIL_CLOUD_AI_SIGNING_KEY=
# OPENPENCIL_CLOUD_SERVICE_TOKEN=

# The AI relay (`node dist-standalone/ai-relay.mjs`) reads its own TOML file and upstream key.
# OPENPENCIL_AI_RELAY_CONFIG=./openpencil-ai-relay.toml
# OPENPENCIL_AI_RELAY_UPSTREAM_KEY=

# Compose infrastructure settings, not Cloud application configuration.
POSTGRES_PASSWORD=openpencil-development-password
S3_REGION=us-east-1
S3_BUCKET=openpencil

# After approving and signing in the first operator, grant the deployment admin role with:
# bun --filter @open-pencil/cloud admin grant owner@example.com
