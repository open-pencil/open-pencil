{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "bun"],
    "paths": {
      "#feedback/*": ["./src/*"],
      "#feedback-tests/*": ["./tests/*"],
      "@open-pencil/scene-graph/random": ["../scene-graph/src/random.ts"],
      "@open-pencil/cloud/email": ["../cloud/src/email/index.ts"],
      "#cloud/*": ["../cloud/src/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "worker-configuration.d.ts"]
}
