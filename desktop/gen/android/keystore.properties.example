# Release signing
#
# `gen/android/app/build.gradle.kts` reads this file (or the matching env vars) when
# signing release builds. Copy it to `desktop/gen/android/keystore.properties` and fill
# in your own keystore — neither this file nor any *.keystore is committed.
#
#   keytool -genkeypair -v -keystore my-release.keystore -alias openpencil \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# `storeFile` is resolved relative to `desktop/gen/android/`.
storeFile=my-release.keystore
storePassword=change-me
keyAlias=openpencil
keyPassword=change-me
