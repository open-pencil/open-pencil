{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "#vite-config/*": [
        "./vite/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "#vue/*": [
        "./packages/vue/src/*",
        "./packages/vue/src/*.vue"
      ],
      "#core/*": [
        "./packages/core/src/*"
      ],
      "#fig/*": [
        "./packages/fig/src/*"
      ],
      "#cli/*": [
        "./packages/cli/src/*"
      ],
      "#mcp/*": [
        "./packages/mcp/src/*"
      ],
      "@lawha/harness": [
        "./packages/harness/src/index.ts"
      ],
      "#feedback/*": [
        "./packages/feedback/src/*"
      ],
      "@lawha/cloud/*": [
        "./packages/cloud/src/*"
      ],
      "#dom-css/*": [
        "./packages/dom-css/src/*"
      ],
      "#tests/*": [
        "./tests/*"
      ],
      "#docs-config/*": [
        "./packages/docs/.vitepress/*"
      ],
      "tinykeys": [
        "./node_modules/tinykeys/dist/tinykeys.d.ts"
      ],
      "@lawha/cli/library": [
        "./packages/cli/src/library/index.ts"
      ],
      "@lawha/vue": [
        "./packages/vue/src/index.ts"
      ],
      "@lawha/vue/*": [
        "./packages/vue/src/*"
      ],
      "@lawha/core": [
        "./packages/core/src/index.ts"
      ],
      "@lawha/core/*": [
        "./packages/core/src/*"
      ],
      "@lawha/dom-css": [
        "./packages/dom-css/src/index.ts"
      ],
      "@lawha/dom-css/scene-graph": [
        "./packages/dom-css/src/import/scene-graph.ts"
      ],
      "@lawha/dom-css/export": [
        "./packages/dom-css/src/export/index.ts"
      ],
      "@lawha/dom-css/*": [
        "./packages/dom-css/src/*"
      ],
      "#scene-graph/*": [
        "./packages/scene-graph/src/*"
      ],
      "@lawha/scene-graph": [
        "./packages/scene-graph/src/index.ts"
      ],
      "@lawha/scene-graph/*": [
        "./packages/scene-graph/src/*"
      ],
      "#drawio/*": [
        "./packages/drawio/src/*"
      ],
      "@lawha/drawio": [
        "./packages/drawio/src/index.ts"
      ],
      "#mermaid/*": [
        "./packages/mermaid/src/*"
      ],
      "@lawha/mermaid": [
        "./packages/mermaid/src/index.ts"
      ],
      "#emit/*": [
        "./packages/emit/src/*"
      ],
      "@lawha/emit": [
        "./packages/emit/src/index.ts"
      ],
      "#design-jsx/*": [
        "./packages/design-jsx/src/*"
      ],
      "@lawha/design-jsx": [
        "./packages/design-jsx/src/index.ts"
      ],
      "#pen/*": [
        "./packages/pen/src/*"
      ],
      "@lawha/pen": [
        "./packages/pen/src/index.ts"
      ],
      "@lawha/pen/*": [
        "./packages/pen/src/*"
      ],
      "#cli-tests/*": [
        "./packages/cli/tests/*"
      ],
      "#cloud/*": [
        "./packages/cloud/src/*"
      ],
      "#cloud-tests/*": [
        "./packages/cloud/tests/*"
      ]
    },
    "types": [
      "bun"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "packages/core/src/global.d.ts",
    "packages/vue/src/global.d.ts",
    "packages/dom-css/src/cssom.d.ts",
    "packages/dom-css/src/postcss-value-parser.d.ts",
    "packages/design-jsx/src/global.d.ts",
    "tests/**/*.ts",
    "packages/*/tests/**/*.ts",
    "packages/*/tests/**/*.tsx",
    "tests/helpers/tauri/native-global.d.ts"
  ],
  "exclude": [
    "tests/e2e/native/**",
    "packages/feedback/**"
  ]
}
