{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "default",
  "description": "What the mobile editor may use",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "os:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "opener:default"
  ]
}
