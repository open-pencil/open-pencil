{
  "name": "@open-pencil/feedback",
  "version": "0.16.0",
  "private": true,
  "license": "MIT",
  "description": "The OpenPencil feedback service on Cloudflare Workers: usage pings, opt-in usage stats, the Cloud waitlist, and the daily metrics snapshot.",
  "type": "module",
  "imports": {
    "#feedback/*": "./src/*",
    "#feedback-tests/*": "./tests/*.ts"
  },
  "exports": {
    "./contract": "./src/contract/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "bun test tests",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json && bunx tsc --noEmit -p tsconfig.tests.json",
    "types": "wrangler types --include-runtime false",
    "check:types": "wrangler types --include-runtime false --check"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.3",
    "@open-pencil/cloud": "workspace:*",
    "@open-pencil/scene-graph": "workspace:*",
    "@vue-email/components": "^0.0.21",
    "@vue-email/render": "^0.0.9",
    "es-toolkit": "^1.52.0",
    "hono": "^4.13.13",
    "jose": "^6.2.8",
    "kysely": "^0.29.6",
    "kysely-d1": "0.4.0",
    "valibot": "^1.5.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@types/bun": "^1.3.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "wrangler": "4.149.0"
  }
}
