// cloud.openpencil.dev, deployed by the Deploy Cloud workflow with target `production` from a
// release tag: a filled-in copy of deploy/cloudflare. Its data stays in the EU (see the runbook in
// deploy/openpencil/README.md).
{
  "name": "openpencil-cloud",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.toml"], "fallthrough": false }],
  "observability": { "enabled": true },
  // The site build comes from `--assets`.
  "assets": {
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "routes": [{ "pattern": "cloud.openpencil.dev", "custom_domain": true }],
  "workers_dev": false,
  // The production Hyperdrive, over the EU Neon database with query caching off.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "your-production-hyperdrive-id" }],
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "CollaborationRelayObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CollaborationRelayObject"] }],
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "S3_ACCESS_KEY_ID",
      "S3_SECRET_ACCESS_KEY",
      "OPENPENCIL_CLOUD_SERVICES_SIGNING_KEY",
      "POSTHOG_PROJECT_API_KEY"
    ]
  }
}
