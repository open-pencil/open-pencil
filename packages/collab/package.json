{
  "name": "@open-pencil/collab",
  "version": "0.17.0",
  "description": "How OpenPencil collaboration rooms work: the room's Yjs document mapped to and from a SceneGraph, the room protocol, and room sessions over any transport.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-pencil/open-pencil.git",
    "directory": "packages/collab"
  },
  "funding": "https://ko-fi.com/dannote",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#collab/*": {
      "types": "./src/*.ts",
      "bun": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#collab-tests/*": "./tests/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bunx tsdown --config tsdown.config.ts",
    "check": "bun run typecheck && bun run test && bun run build",
    "prepack": "bun run build",
    "test": "bun test tests",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@open-pencil/scene-graph": "workspace:*",
    "@open-pencil/std": "workspace:*",
    "es-toolkit": "^1.52.0",
    "fflate": "^0.8.3",
    "lib0": "^0.2.117",
    "valibot": "^1.5.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@open-pencil/package-artifacts-tools": "workspace:*",
    "@open-pencil/test-support": "workspace:*",
    "@types/bun": "^1.3.14",
    "tsdown": "^0.22.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
