{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": { "maxDuration": 60 },
    "api/internal/cleanup.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/internal/cleanup", "destination": "/api/internal/cleanup" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [{ "path": "/api/internal/cleanup", "schedule": "0 * * * *" }]
}
