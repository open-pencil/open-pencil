# Harness sidecar build output
/binaries/

# Cargo build output
/target/

# Tauri-generated capability schemas (gen/schemas/*.json) and Android build output are
# machine-specific and regenerated by build.rs / Gradle. The Android Gradle project
# under gen/android is nevertheless tracked, because it carries hand-written changes:
# MainActivity, launcher icons, signing config and the mobile capability wiring.
/gen/*
!/gen/android/
/gen/android/build/
/gen/android/app/build/
/gen/android/buildSrc/build/
/gen/android/.gradle/
/gen/android/.kotlin/
/gen/android/local.properties
/gen/android/tauri.properties
/gen/android/tauri.build.gradle.kts
# Generated by `tauri android init`: absolute paths into the local cargo registry.
/gen/android/tauri.settings.gradle
# Release signing material — never committed.
/gen/android/keystore.properties
/gen/android/*.keystore
/gen/android/*.jks
