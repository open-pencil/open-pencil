{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.base.schema.json",
  "name": "Lawha",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/lawha,type=bind,consistency=cached",
  "workspaceFolder": "/workspace/lawha",
  "remoteUser": "bun",
  "updateRemoteUserUID": true,
  "mounts": [
    "source=lawha-root-modules-${devcontainerId},target=/workspace/lawha/node_modules,type=volume",
    "source=lawha-scene-graph-modules-${devcontainerId},target=/workspace/lawha/packages/scene-graph/node_modules,type=volume",
    "source=lawha-pen-modules-${devcontainerId},target=/workspace/lawha/packages/pen/node_modules,type=volume",
    "source=lawha-kiwi-modules-${devcontainerId},target=/workspace/lawha/packages/kiwi/node_modules,type=volume",
    "source=lawha-fig-modules-${devcontainerId},target=/workspace/lawha/packages/fig/node_modules,type=volume",
    "source=lawha-core-modules-${devcontainerId},target=/workspace/lawha/packages/core/node_modules,type=volume",
    "source=lawha-dom-css-modules-${devcontainerId},target=/workspace/lawha/packages/dom-css/node_modules,type=volume",
    "source=lawha-design-jsx-modules-${devcontainerId},target=/workspace/lawha/packages/design-jsx/node_modules,type=volume",
    "source=lawha-emit-modules-${devcontainerId},target=/workspace/lawha/packages/emit/node_modules,type=volume",
    "source=lawha-vue-modules-${devcontainerId},target=/workspace/lawha/packages/vue/node_modules,type=volume",
    "source=lawha-cli-modules-${devcontainerId},target=/workspace/lawha/packages/cli/node_modules,type=volume",
    "source=lawha-mcp-modules-${devcontainerId},target=/workspace/lawha/packages/mcp/node_modules,type=volume",
    "source=lawha-docs-modules-${devcontainerId},target=/workspace/lawha/packages/docs/node_modules,type=volume",
    "source=lawha-docs-tool-modules-${devcontainerId},target=/workspace/lawha/tools/docs/node_modules,type=volume"
  ],
  "postCreateCommand": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git lfs pull; fi && bun install --frozen-lockfile",
  "containerEnv": {
    "TAURI_DEV_HOST": "0.0.0.0"
  },
  "forwardPorts": [1420],
  "portsAttributes": {
    "1420": {
      "label": "Lawha web editor",
      "onAutoForward": "notify"
    }
  }
}
