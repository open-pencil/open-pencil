{
  "name": "@open-pencil/std",
  "version": "0.17.0-beta.5",
  "description": "OpenPencil's own standard library beside es-toolkit: deadlines and backoff, secure randomness, error and record guards, deferreds and a mutex, array helpers safe for large inputs, and JSON types. No dependencies, for browsers, Node, Bun, and Workers alike.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-pencil/open-pencil.git",
    "directory": "packages/std"
  },
  "funding": "https://ko-fi.com/dannote",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#std/*": {
      "types": "./src/*.ts",
      "bun": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    "./timing": {
      "types": "./dist/timing.d.ts",
      "bun": "./src/timing.ts",
      "import": "./dist/timing.js",
      "default": "./dist/timing.js"
    },
    "./random": {
      "types": "./dist/random.d.ts",
      "bun": "./src/random.ts",
      "import": "./dist/random.js",
      "default": "./dist/random.js"
    },
    "./arrays": {
      "types": "./dist/arrays.d.ts",
      "bun": "./src/arrays.ts",
      "import": "./dist/arrays.js",
      "default": "./dist/arrays.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "bun": "./src/json.ts",
      "import": "./dist/json.js",
      "default": "./dist/json.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "bun": "./src/errors.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./records": {
      "types": "./dist/records.d.ts",
      "bun": "./src/records.ts",
      "import": "./dist/records.js",
      "default": "./dist/records.js"
    },
    "./async": {
      "types": "./dist/async.d.ts",
      "bun": "./src/async.ts",
      "import": "./dist/async.js",
      "default": "./dist/async.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bunx tsdown --config tsdown.config.ts",
    "check": "bun run typecheck && bun run build",
    "prepack": "bun run build",
    "test": "bun test tests",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@open-pencil/package-artifacts-tools": "workspace:*",
    "@types/bun": "^1.3.14",
    "tsdown": "^0.22.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
