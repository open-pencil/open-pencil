{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openpencil-cloud-adapter-skeleton",
  "main": "worker.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Configure these as Worker secrets for R2's official S3-compatible presigned URL flow:
  // S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
  // S3_REGION=auto, S3_FORCE_PATH_STYLE=false, S3_CHECKSUM_VERIFICATION=metadata
  // S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "replace-with-hyperdrive-id" }],
  "triggers": { "crons": ["0 * * * *"] }
}
