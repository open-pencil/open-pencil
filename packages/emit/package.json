{
  "name": "@open-pencil/emit",
  "version": "0.15.1",
  "description": "How OpenPencil exporters emit source: JavaScript, TypeScript, and JSX built as ESTree and printed with esrap.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-pencil/open-pencil.git",
    "directory": "packages/emit"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#emit/*": {
      "types": "./src/*",
      "bun": "./src/*",
      "default": "./dist/*"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bunx tsdown --config tsdown.config.ts",
    "check": "bun run typecheck && bun run build && bun run smoke:dist",
    "prepack": "bun run build",
    "smoke:dist": "bun scripts/smoke-dist.ts",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sveltejs/acorn-typescript": "^1.0.13",
    "acorn": "^8.18.0",
    "entities": "^8.0.0",
    "esrap": "^2.3.11"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "tsdown": "^0.22.14",
    "typescript": "~5.8.3",
    "vue": "^3.5.43"
  }
}
