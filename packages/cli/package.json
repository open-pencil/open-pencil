{
  "name": "@lawha/cli",
  "version": "0.17.0-beta.1",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#cli/*": "./src/*.ts",
    "#cli-tests/*": "./tests/*.ts"
  },
  "bin": {
    "lawha": "./bin/lawha.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./commands": {
      "types": "./dist/commands/index.d.mts",
      "bun": "./src/commands/index.ts",
      "import": "./dist/commands/index.mjs",
      "default": "./dist/commands/index.mjs"
    },
    "./library": {
      "types": "./dist/library/index.d.mts",
      "bun": "./src/library/index.ts",
      "import": "./dist/library/index.mjs",
      "default": "./dist/library/index.mjs"
    }
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bunx tsdown --config tsdown.config.ts",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliaaldihnayn-lab/design.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@lawha/core": "workspace:*",
    "@lawha/dom-css": "workspace:*",
    "@lawha/mcp": "workspace:*",
    "@lawha/scene-graph": "workspace:*",
    "@valibot/to-json-schema": "^1.8.0",
    "agentfmt": "^0.1.3",
    "canvaskit-wasm": "^0.41.1",
    "citty": "^0.1.6",
    "es-toolkit": "^1.52.0",
    "js-base64": "^3.9.3",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@lawha/fig": "workspace:*",
    "@types/bun": "^1.3.14"
  }
}
