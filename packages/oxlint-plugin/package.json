{
  "name": "@open-pencil/oxlint-plugin",
  "version": "0.17.0-beta.2",
  "description": "OpenPencil's code conventions as Oxlint rules: validated JSON, Valibot schema placement, no broad casts, no silent catches, no secrets in logs or URLs, and more.",
  "keywords": [
    "lint",
    "oxlint",
    "oxlint-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-pencil/open-pencil.git",
    "directory": "packages/oxlint-plugin"
  },
  "files": [
    "dist",
    "src",
    "recommended.json",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#oxlint-plugin/*": "./src/*.ts",
    "#oxlint-plugin-tests/*": "./tests/*.ts"
  },
  "exports": {
    "./data": {
      "types": "./dist/plugins/data.d.ts",
      "bun": "./src/plugins/data.ts",
      "import": "./dist/plugins/data.js",
      "default": "./dist/plugins/data.js"
    },
    "./imports": {
      "types": "./dist/plugins/imports.d.ts",
      "bun": "./src/plugins/imports.ts",
      "import": "./dist/plugins/imports.js",
      "default": "./dist/plugins/imports.js"
    },
    "./runtime": {
      "types": "./dist/plugins/runtime.d.ts",
      "bun": "./src/plugins/runtime.ts",
      "import": "./dist/plugins/runtime.js",
      "default": "./dist/plugins/runtime.js"
    },
    "./security": {
      "types": "./dist/plugins/security.d.ts",
      "bun": "./src/plugins/security.ts",
      "import": "./dist/plugins/security.js",
      "default": "./dist/plugins/security.js"
    },
    "./structure": {
      "types": "./dist/plugins/structure.d.ts",
      "bun": "./src/plugins/structure.ts",
      "import": "./dist/plugins/structure.js",
      "default": "./dist/plugins/structure.js"
    },
    "./types": {
      "types": "./dist/plugins/types.d.ts",
      "bun": "./src/plugins/types.ts",
      "import": "./dist/plugins/types.js",
      "default": "./dist/plugins/types.js"
    },
    "./recommended": {
      "types": "./dist/recommended.d.ts",
      "bun": "./src/recommended.ts",
      "import": "./dist/recommended.js",
      "default": "./dist/recommended.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bunx tsdown --config tsdown.config.ts",
    "check": "bun run typecheck && bun run test && bun run build",
    "prepack": "bun run build",
    "test": "bun test tests",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@oxlint/plugins": "1.57.0",
    "es-toolkit": "^1.52.0"
  },
  "peerDependencies": {
    "oxlint": ">=1.90.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@open-pencil/package-artifacts-tools": "workspace:*"
  }
}
