{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "#feedback/*": ["./src/*"],
      "@lawha/scene-graph/random": ["../scene-graph/src/random.ts"],
      "@lawha/cloud/email": ["../cloud/src/email/index.ts"],
      "#cloud/*": ["../cloud/src/*"]
    }
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts"]
}
