{
  "name": "@open-pencil/ui",
  "version": "0.14.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#ui/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "openpencil-source": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": ["**/*.css"],
  "files": ["dist", "src/styles.css", "src/styles/tokens.css"],
  "scripts": {
    "build": "bunx tsdown --config tsdown.config.ts",
    "typecheck": "bunx vue-tsc --noEmit -p tsconfig.json",
    "check": "bun run typecheck && bun run build"
  },
  "peerDependencies": {
    "vue": "^3.5.41"
  },
  "dependencies": {
    "reka-ui": "^2.10.3",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "~5.8.3",
    "unplugin-vue": "^7.2.0",
    "vue-tsc": "^3.3.10"
  }
}
