{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "host-processes",
  "description": "Spawning host programs from the main window: ACP agents, npm installs of OpenPencil companions, the MCP server, and the Pi harness. Granted at startup unless OPENPENCIL_HOST_PROCESSES turns it off (desktop/src/capabilities.rs).",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "claude-agent-acp", "cmd": "claude-agent-acp", "args": false },
        {
          "name": "claude-agent-acp-sign-in",
          "cmd": "claude-agent-acp",
          "args": ["--cli", "auth", "login", "--claudeai"]
        },
        { "name": "codex-acp", "cmd": "codex-acp", "args": false },
        { "name": "gemini", "cmd": "gemini", "args": ["--acp"] },
        { "name": "agy", "cmd": "agy", "args": ["acp", "--process-per-session"] },
        { "name": "cursor-agent", "cmd": "cursor-agent", "args": ["acp"] },
        { "name": "grok", "cmd": "grok", "args": ["agent", "stdio"] },
        {
          "name": "npm",
          "cmd": "npm",
          "args": [
            "install",
            "--global",
            {
              "validator": "^(@agentclientprotocol/(claude-agent-acp|codex-acp)|@open-pencil/(mcp|harness)@[0-9]+\\.[0-9]+\\.[0-9]+(-beta\\.[1-9][0-9]*)?)$"
            },
            "--registry=https://registry.npmjs.org"
          ]
        },
        {
          "name": "bun",
          "cmd": "bun",
          "args": [
            "add",
            "--global",
            {
              "validator": "^@open-pencil/(mcp|harness)@[0-9]+\\.[0-9]+\\.[0-9]+(-beta\\.[1-9][0-9]*)?$"
            },
            "--registry=https://registry.npmjs.org"
          ]
        },
        { "name": "openpencil-mcp-http", "cmd": "openpencil-mcp-http", "args": false },
        { "name": "openpencil-harness", "cmd": "openpencil-harness", "args": false },
        { "name": "cmd-claude-agent-acp", "cmd": "cmd", "args": ["/c", "claude-agent-acp"] },
        {
          "name": "cmd-claude-agent-acp-sign-in",
          "cmd": "cmd",
          "args": ["/c", "claude-agent-acp", "--cli", "auth", "login", "--claudeai"]
        },
        { "name": "cmd-codex-acp", "cmd": "cmd", "args": ["/c", "codex-acp"] },
        { "name": "cmd-gemini", "cmd": "cmd", "args": ["/c", "gemini", "--acp"] },
        { "name": "cmd-agy", "cmd": "cmd", "args": ["/c", "agy", "acp", "--process-per-session"] },
        { "name": "cmd-cursor-agent", "cmd": "cmd", "args": ["/c", "cursor-agent", "acp"] },
        { "name": "cmd-grok", "cmd": "cmd", "args": ["/c", "grok", "agent", "stdio"] },
        {
          "name": "cmd-npm",
          "cmd": "cmd",
          "args": [
            "/c",
            "npm",
            "install",
            "--global",
            {
              "validator": "^(@agentclientprotocol/(claude-agent-acp|codex-acp)|@open-pencil/(mcp|harness)@[0-9]+\\.[0-9]+\\.[0-9]+(-beta\\.[1-9][0-9]*)?)$"
            },
            "--registry=https://registry.npmjs.org"
          ]
        },
        {
          "name": "cmd-bun",
          "cmd": "cmd",
          "args": [
            "/c",
            "bun",
            "add",
            "--global",
            {
              "validator": "^@open-pencil/(mcp|harness)@[0-9]+\\.[0-9]+\\.[0-9]+(-beta\\.[1-9][0-9]*)?$"
            },
            "--registry=https://registry.npmjs.org"
          ]
        },
        { "name": "cmd-openpencil-mcp-http", "cmd": "cmd", "args": ["/c", "openpencil-mcp-http"] },
        { "name": "cmd-openpencil-harness", "cmd": "cmd", "args": ["/c", "openpencil-harness"] }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill"
  ]
}
