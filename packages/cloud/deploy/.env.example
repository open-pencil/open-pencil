OPENPENCIL_CLOUD_CONFIG=/etc/openpencil/openpencil-cloud.toml
OPENPENCIL_CLOUD_DEPLOYMENT=self-hosted
OPENPENCIL_CLOUD_URL=http://localhost:8787
OPENPENCIL_CLOUD_APP_URL=http://localhost:5173
# Optional dedicated Hocuspocus relay URL. When set, Cloud collaboration tickets use
# server-enforced WebSocket sessions instead of temporary Trystero rooms.
# OPENPENCIL_CLOUD_COLLABORATION_URL=ws://localhost:1234
# OPENPENCIL_CLOUD_COLLABORATION_PORT=1234
OPENPENCIL_CLOUD_TRUSTED_ORIGINS=http://localhost:5173
OPENPENCIL_CLOUD_CLEANUP_ENABLED=true
OPENPENCIL_CLOUD_CLEANUP_BATCH_SIZE=100
OPENPENCIL_CLOUD_CLEANUP_INTERVAL_MS=60000
OPENPENCIL_CLOUD_CLEANUP_LEASE_MS=300000
OPENPENCIL_CLOUD_DOCUMENT_RETENTION_MS=2592000000
POSTGRES_PASSWORD=openpencil-development-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
S3_REGION=us-east-1
S3_BUCKET=openpencil
S3_ACCESS_KEY_ID=openpencil
S3_SECRET_ACCESS_KEY=openpencil-development-secret
S3_CHECKSUM_VERIFICATION=metadata

# Used when running the Cloud server outside Compose:
# DATABASE_URL=postgresql://openpencil:openpencil-development-password@localhost:54329/openpencil
# S3_ENDPOINT=http://localhost:8333
# S3_FORCE_PATH_STYLE=true

# Optional SMTP invitation delivery (Node runtime):
# OPENPENCIL_CLOUD_SMTP_HOST=smtp.example.com
# OPENPENCIL_CLOUD_SMTP_PORT=465
# OPENPENCIL_CLOUD_SMTP_SECURE=true
# OPENPENCIL_CLOUD_SMTP_USER=
# OPENPENCIL_CLOUD_SMTP_PASSWORD=
# OPENPENCIL_CLOUD_EMAIL_FROM=OpenPencil <cloud@example.com>

# Optional social sign-in:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_APP_BUNDLE_IDENTIFIER=
