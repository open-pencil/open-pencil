OPENPENCIL_CLOUD_DEPLOYMENT=self-hosted
OPENPENCIL_CLOUD_URL=http://localhost:8787
OPENPENCIL_CLOUD_TRUSTED_ORIGINS=http://localhost:5173
POSTGRES_PASSWORD=openpencil-development-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
S3_REGION=us-east-1
S3_BUCKET=openpencil
S3_ACCESS_KEY_ID=openpencil
S3_SECRET_ACCESS_KEY=openpencil-development-secret
S3_CHECKSUM_VERIFICATION=metadata

# Used when running the Cloud server outside Compose:
# DATABASE_URL=postgresql://openpencil:openpencil-development-password@localhost:54329/openpencil
# S3_ENDPOINT=http://localhost:8333
# S3_FORCE_PATH_STYLE=true

# Optional social sign-in:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_APP_BUNDLE_IDENTIFIER=
