{
  "name": "@open-pencil/docs",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "imports": {
    "#docs/*": "./.vitepress/*"
  },
  "scripts": {
    "dev": "vitepress dev",
    "build": "OPENPENCIL_DOCS_FAST_BUILD=1 NODE_OPTIONS=--max-old-space-size=8192 vitepress build --minify=false --buildConcurrency=8",
    "build:production": "NODE_OPTIONS=--max-old-space-size=8192 vitepress build --minify=esbuild --buildConcurrency=8",
    "check": "bun ../../tools/checks/docs/src/check.ts",
    "preview": "vitepress preview"
  },
  "devDependencies": {
    "@iconify-json/simple-icons": "^1.2.98",
    "@open-pencil/brand-tools": "workspace:*",
    "@open-pencil/cli": "workspace:*",
    "@open-pencil/demo-tools": "workspace:*",
    "@open-pencil/vite-config": "workspace:*",
    "@shikijs/vitepress-twoslash": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "vitepress": "^2.0.0-alpha.19",
    "vitepress-plugin-llms": "1.12.2",
    "vue": "^3.5.43",
    "vue-component-meta": "^3.3.10"
  },
  "dependencies": {
    "@ai-sdk/vue": "^4.0.66",
    "@iconify/vue": "^5.0.1",
    "@open-pencil/core": "workspace:*",
    "@open-pencil/design-jsx": "workspace:*",
    "@open-pencil/dom-css": "workspace:*",
    "@open-pencil/scene-graph": "workspace:*",
    "@vueuse/core": "^14.4.0",
    "ai": "^7.0.66",
    "canvaskit-wasm": "^0.41.1",
    "dedent": "^1.7.2"
  }
}
